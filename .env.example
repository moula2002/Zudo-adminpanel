# Zudo Admin Panel Configuration Template
# Backend proxy URL for Vite dev server (set to http://localhost:5000 for local backend or production domain)
VITE_BACKEND_URL=https://snbtradingco.in

# Socket.IO connection URL
VITE_SOCKET_URL=https://snbtradingco.in

# Override the backend API endpoint base url (defaults to window.location.origin/api if blank)
VITE_API_URL=https://snbtradingco.in/api

# Override the production domain for media and image resources
VITE_PRODUCTION_DOMAIN=https://snbtradingco.in

# Override the base URL specifically for notification and auth operations
VITE_NOTIFICATION_API_URL=https://snbtradingco.in/api


